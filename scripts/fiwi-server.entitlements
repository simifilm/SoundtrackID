<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the bundled PyInstaller `fiwi-server` binary.

  Required to run a Python interpreter (with numpy/scipy/onnxruntime and other
  C extensions) under macOS Hardened Runtime, which notarization mandates:

  - disable-library-validation: PyInstaller loads its own dylibs/.so files that
    are not signed by our Team ID. Without this, Hardened Runtime blocks them.
  - allow-unsigned-executable-memory / allow-jit: some C extensions allocate
    executable memory at runtime.
  - allow-dyld-environment-variables: PyInstaller may set DYLD_* to locate its
    bundled libraries.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
